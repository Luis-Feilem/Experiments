# Expected name: kafka_base
# Kafka Base Dockerfile
FROM core_base

# Install ZeroMQ-specific dependencies
RUN apt-get update && apt-get install -y \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/technologies
RUN mkdir -p /app/technologies/kafka
COPY ./technologies/kafka /app/technologies/kafka

# Build the ZeroMQ-specific library
RUN cd /app/build && cmake .. &&  cmake --build . --clean-first
