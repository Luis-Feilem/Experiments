# Inherit from base image
FROM base-image:latest

# Install ZeroMQ and nlohmann-json (technology-specific dependencies)
RUN apt-get update && \
    apt-get install -y libczmq-dev nlohmann-json3-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy ZeroMQ-specific files
COPY ./technologies/zeromq_p2p /app/technologies/zeromq_p2p

# Build from root but target the specific ZeroMQ application
WORKDIR /app
RUN cmake -B build -S ./technologies/zeromq_p2p \
    -DCMAKE_SYSTEM_NAME=Linux \
    -DCMAKE_SYSTEM_PROCESSOR=x86_64 \
    -DCMAKE_VERBOSE_MAKEFILE=ON && \
    cmake --build build --target build-zeromqp2p-publisher && \
    cmake --build build --target build-zeromqp2p-consumer

# Ensure the binaries have execution permissions
RUN chmod +x ./build/ZeroMQPublisherAppP2P ./build/ZeroMQConsumerAppP2P
