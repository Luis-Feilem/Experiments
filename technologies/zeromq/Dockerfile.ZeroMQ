# Inherit from base image
FROM base-image:latest

# Install ZeroMQ
RUN apt-get update && \
    apt-get install -y libzmq3-dev && \
    rm -rf /var/lib/apt/lists/*

# Rebuild to ensure ZeroMQ is linked properly
RUN cmake -B build && cmake --build build

# Define working directory for ZeroMQ components
WORKDIR /app/build/technologies/zeromq
