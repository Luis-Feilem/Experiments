# Ignore system files
.DS_Store Thumbs.db

# Ignore build artifacts
*.exe
*.obj
*.o
*.dll
*.lib
*.pdb
*.ilk
*.idb
*.exp

# Ignore CMake temporary files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build/

# Ignore VS Code workspace settings
.vscode/
*.code-workspace

# Ignore dependency management directories
vcpkg_installed/
vcpkg/buildtrees/
vcpkg/packages/

# Ignore Docker-related files
*.dockerignore
docker-compose.override.yml

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Ignore Python virtual environments (if used for data processing)
venv/
__pycache__/
*.pyc

# Ignore CSV and benchmarking results
results/*.csv
logs/

# Ignore environment-specific files
.env

