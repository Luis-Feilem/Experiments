{
    "producerAssignmentStrategy": ["round-robin", "random"],
    "consumerAssignmentStrategy": ["round-robin", "shared"],
    "common":{
        "numProducersPerTopic": {
            "lower": 1,
            "upper": 100,
            "step": 1,
            "step_operator": "+"
        },
        "numConsumers": {
            "lower": 1,
            "upper": 100,
            "step": 1,
            "step_operator": "+"
        },
        "numTopics": {
            "lower": 1,
            "upper": 100,
            "step": 1,
            "step_operator": "+",
            "midpoint": 10,
            "step2": 10,
            "step_operator2": "+"
        },
        "parallelSubscriptionsPerTopic":{
            "lower": 1,
            "upper": 16,
            "step": 1,
            "step_operator": "+"
        },
        "messageSizeBytes":{
            "lower": 64,
            "upper": 1048576, up to 100KB
            "step": 2,
            "step_operator": "*",
            "midpoint": 1024,
            "step2": 10,
            "step_operator2": "*"
        },
        "producerWaitInMicroSeconds":{
            "lower": 1,
            "upper": 100000, so that at maximum size we have around 50Mbps
            "step": 2,
            "step_operator": "*",
            "midpoint": 1000,
            "step2": 1000,
            "step_operator2": "+"
        },
        "backlogSizeMessages":{
            "lower": 0,
            "upper": 1000000,
            "step": 1,
            "step_operator": "+",
            "midpoint": 1,
            "step2": 10,
            "step_operator2": "*"
        }
    },
    "exclusive": {
        "testDurationS": {
            "lower": 10,
            "upper": 640,
            "step": 2,
            "step_operator": "*"
        },
        "numberOfMessages":{
            "lower": 10,
            "upper": 1000000,
            "step": 10,
            "step_operator": "*"
        }
    },
    "network": {
        "bandwidthMbps": {
            "lower": 1,
            "upper": 10000,
            "step": 2,
            "step_operator": "*",
            "midpoint": 1000,
            "step2": 1000,
            "step_operator2": "+"
        },
        "latencyMs":{
            "lower": 0,
            "upper": 500,
            "step": 1,
            "step_operator": "+",
            "midpoint": 10,
            "step2": 10,
            "step_operator2": "+"
        },
        "packetLossPerc":{
            "lower": 0,
            "upper": 10,
            "step": 0.1,
            "step_operator": "+",
            "midpoint": 1,
            "step2": 1,
            "step_operator2": "+"
        },
        "jitterMs":{
            "lower": 0,
            "upper": 100,
            "step": 1,
            "step_operator": "+"
        }
    }
}